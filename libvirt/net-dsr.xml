<!--
  net-dsr: NAT-forwarded libvirt network for the DSR lab (forward= NAT gives
  the guests internet for apt provisioning; intra-segment DSR traffic is
  never forwarded, so the DSR packet flow is unaffected). Host bridge is
  virbr-dsr (gateway 192.168.100.1). Guests are STATIC (cloud-init
  network-config), so there is deliberately no DHCP here.
-->
<network>
  <name>net-dsr</name>
  <forward mode='nat'/>
  <bridge name='virbr-dsr' stp='on' delay='0'/>
  <ip address='192.168.100.1' netmask='255.255.255.0'/>
</network>
