# rs1 NIC pinned by MAC so the interface is always eth0. Static addressing:
# no DHCP in the lab, hosts are pinned (see README).
version: 2
ethernets:
  eth0:
    match:
      macaddress: "52:54:00:aa:00:21"
    set-name: eth0
    addresses: [192.168.100.21/24]
    routes:
      - to: default
        via: 192.168.100.1
    nameservers:
      addresses: [192.168.100.1]
