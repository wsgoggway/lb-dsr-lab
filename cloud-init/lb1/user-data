#cloud-config
# lb1 - FreeBSD 14.5 pf DSR load balancer.
#
# Only users / write_files / runcmd are used so this works with both
# nuageinit (base system) and the python cloud-init shipped in the
# BASIC-CLOUDINIT image; every runcmd entry is a shell-safe one-liner.
# The base image already has growfs_enable="YES" in rc.conf, so the disk
# grows on first boot without extra config here.
hostname: lb1
users:
  - name: lab
    shell: /bin/sh
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - "@SSH_PUBKEY@"
write_files:
  # Root access for the lab (the FreeBSD cloud image has NO sudo): the lab
  # key is placed directly into /root/.ssh - write_files runs as root.
  - path: /root/.ssh/authorized_keys
    permissions: '0600'
    content: |
      @SSH_PUBKEY@
runcmd:
  # Static addressing: no DHCP in the lab, hosts are pinned (see README).
  - 'sysrc ifconfig_vtnet0="inet 192.168.100.11/24"'
  - 'sysrc ifconfig_vtnet0_alias0="inet 192.168.100.200/32"'
  - 'sysrc defaultrouter="192.168.100.1"'
  # Raises net.inet.ip.forwarding - needed by the NAT comparison mode.
  - 'sysrc gateway_enable="YES"'
  - 'sysrc sshd_enable="YES"'
  - 'sysrc pf_enable="YES"'
  - 'sysrc pf_rules="/etc/pf.conf"'
  # nuageinit applied only the FIRST write_files entry, so pf.conf is
  # delivered here as base64 (openssl base64 is in the base system).
  - 'printf "%s" "" | openssl base64 -d -A > /etc/pf.conf'
  - 'sysctl net.inet.ip.forwarding=1'
  # Runtime addresses (rc.conf entries above persist them across reboots).
  - 'ifconfig vtnet0 inet 192.168.100.11/24'
  - 'ifconfig vtnet0 alias 192.168.100.200/32'
  # Offloads off so tcpdump on the host bridge shows readable packets.
  - 'ifconfig vtnet0 -tso -lro -rxcsum -txcsum'
  # pf.ko may not be loaded yet at first-boot runcmd time; rc.d/pf handles it
  # on subsequent boots via pf_enable="YES".
  - 'kldload pf || true'
  - 'pfctl -f /etc/pf.conf || true'
  - 'pfctl -e || true'
  # The FreeBSD cloud image has NO sudo: expose the lab key to root instead,
  # so tests and pf-mode.sh can run privileged commands via root@lb1.
  - 'mkdir -p /root/.ssh'
  - 'cp /home/lab/.ssh/authorized_keys /root/.ssh/authorized_keys || true'
  - 'chmod 600 /root/.ssh/authorized_keys || true'
  - 'chmod 700 /root/.ssh || true'
  - 'ssh-keygen -A >/dev/null 2>&1 || true'
  - 'printf "\n# lb-dsr-lab\nPermitRootLogin yes\nPubkeyAuthentication yes\n" >> /etc/ssh/sshd_config'
  - 'sysrc sshd_permit_root_login="YES"'
  - 'service sshd restart >/dev/null 2>&1 || true'
  # Diagnostics readable without root (dropped after the lab stabilizes).
  - 'sleep 2; cp /var/log/auth.log /tmp/auth-copy.txt 2>/dev/null || true'
  - 'sshd -T > /tmp/sshd-T.txt 2>&1 || true'
  - 'cp /var/log/messages /tmp/nuage-messages.txt 2>/dev/null || true'
