# lb1 NICs: virtio -> vtnet0 (net-dsr lab segment) and vtnet1 (net-sync,
# the CARP/pfsync control-plane /30). MAC-pinned so the sync link is always
# vtnet1.
version: 2
ethernets:
  vtnet0:
    match:
      macaddress: "52:54:00:aa:00:11"
    set-name: vtnet0
    addresses: [192.168.100.11/24]
    routes:
      - to: default
        via: 192.168.100.1
    nameservers:
      addresses: [192.168.100.1]
  vtnet1:
    match:
      macaddress: "52:54:00:aa:01:11"
    set-name: vtnet1
    addresses: [10.0.100.1/30]
